import { ScrollView, Button } from "std-widgets.slint";
import { StudioTheme, StudioTitleBar, MetadataRow } from "design.slint";
export struct DetailTag { name: string, query: string }
export struct DetailSwatch { value: string, tint: brush }
export component DetailWindow inherits Window {
    icon: @image-url("../resources/wallhaven-studio.png");
    in-out property <string> wallpaper-id;
    in-out property <image> original;
    in-out property <bool> image-loaded;
    in-out property <bool> image-busy: true;
    in-out property <bool> metadata-busy: true;
    in-out property <string> load-message: "正在连接原图…";
    in-out property <string> action-message;
    in-out property <bool> failed;
    in-out property <float> progress: -1;
    in-out property <string> resolution: "—";
    in-out property <string> file-size: "—";
    in-out property <string> file-format: "—";
    in-out property <string> category: "—";
    in-out property <string> uploader: "—";
    in-out property <bool> uploader-available;
    in-out property <string> views: "—";
    in-out property <string> favorites: "—";
    in-out property <string> created-at: "—";
    in-out property <[DetailTag]> tags;
    in-out property <[DetailSwatch]> palette;
    in-out property <bool> downloading;
    in-out property <bool> wallpaper-busy;
    in-out property <float> zoom: 1;
    in-out property <length> pan-x;
    in-out property <length> pan-y;
    out property <length> viewport-left: image-viewport.x;
    out property <length> viewport-top: image-viewport.y;
    out property <length> viewport-width: image-viewport.width;
    out property <length> viewport-height: image-viewport.height;
    callback retry();
    callback open-uploader();
    callback download();
    callback favorite();
    callback copy-link();
    callback browser-open();
    callback open-folder();
    callback set-wallpaper();
    callback search-tag(string);
    callback search-color(string);
    no-frame: true; resize-border-width: root.maximized ? 0px : 6px;
    title: "壁纸 " + root.wallpaper-id + " - WallHaven Studio";
    preferred-width: 1120px; preferred-height: 760px; min-width: 800px; min-height: 560px;
    max-width: 100000px; max-height: 100000px;
    background: StudioTheme.canvas; default-font-family: "Segoe UI"; default-font-size: 13px;
    VerticalLayout {
        StudioTitleBar { caption: "壁纸 " + root.wallpaper-id; maximized <=> root.maximized; minimize => { root.minimized = true; } close-window => { root.close(); } }
        HorizontalLayout {
            padding: 12px; spacing: 12px; vertical-stretch: 1;
            VerticalLayout {
                horizontal-stretch: 1; spacing: 10px;
                image-viewport := Rectangle {
                    background: #101114; clip: true; vertical-stretch: 1;
                    Image {
                        source: root.original; visible: root.image-loaded; image-fit: contain;
                        width: parent.width * root.zoom; height: parent.height * root.zoom;
                        x: (parent.width - self.width) / 2 + root.pan-x;
                        y: (parent.height - self.height) / 2 + root.pan-y;
                    }
                    TouchArea {
                        private property <length> old-x;
                        private property <length> old-y;
                        pointer-event(event) => { if event.kind == PointerEventKind.down { self.old-x = root.pan-x; self.old-y = root.pan-y; } }
                        moved => { if self.pressed { root.pan-x = self.old-x + self.mouse-x - self.pressed-x; root.pan-y = self.old-y + self.mouse-y - self.pressed-y; } }
                        scroll-event(event) => {
                            if root.image-loaded {
                                let old-zoom = root.zoom;
                                let next-zoom = min(8,max(1,old-zoom + (event.delta-y > 0px ? 0.2 : -0.2)));
                                let anchor-x = self.mouse-x - self.width / 2;
                                let anchor-y = self.mouse-y - self.height / 2;
                                root.pan-x = anchor-x - (anchor-x - root.pan-x) * next-zoom / old-zoom;
                                root.pan-y = anchor-y - (anchor-y - root.pan-y) * next-zoom / old-zoom;
                                root.zoom = next-zoom;
                            }
                            accept
                        }
                        double-clicked => { root.zoom = 1; root.pan-x = 0px; root.pan-y = 0px; }
                    }
                    if !root.image-loaded : Text { text: root.failed ? "原图未加载" : "正在加载原图"; color: StudioTheme.muted; horizontal-alignment: center; vertical-alignment: center; }
                }
                HorizontalLayout {
                    height: 34px; spacing: 8px;
                    Button { text: "缩小"; enabled: root.image-loaded; clicked => { root.zoom = max(1,root.zoom - 0.25); } }
                    Button { text: "适应窗口"; clicked => { root.zoom = 1; root.pan-x = 0px; root.pan-y = 0px; } }
                    Button { text: "放大"; enabled: root.image-loaded; clicked => { root.zoom = min(8,root.zoom + 0.25); } }
                    Text { text: "滚轮缩放 · 拖动平移"; color: StudioTheme.muted; font-size: 11px; vertical-alignment: center; horizontal-stretch: 1; }
                }
                if root.progress >= 0 && root.image-busy : Rectangle {
                    height: 3px; background: StudioTheme.border;
                    Rectangle { width: parent.width * min(1,max(0,root.progress)); height: parent.height; background: StudioTheme.accent; }
                }
                HorizontalLayout {
                    min-height: 32px; spacing: 8px;
                    Text { text: root.load-message; color: root.failed ? StudioTheme.danger : StudioTheme.muted; wrap: word-wrap; horizontal-stretch: 1; min-width: 0px; font-size: 12px; }
                    if root.failed : Button { text: "重试加载"; clicked => { root.retry(); } }
                }
            }
            ScrollView {
                width: 286px; content-height: metadata.preferred-height; content-width: self.visible-width;
                metadata := VerticalLayout {
                    width: parent.visible-width; padding: 8px; spacing: 10px;
                    Text { text: "ID  " + root.wallpaper-id; color: StudioTheme.accent; font-size: 16px; font-weight: 600; }
                    MetadataRow { label: "分辨率"; value: root.resolution; }
                    MetadataRow { label: "体积"; value: root.file-size; }
                    MetadataRow { label: "格式"; value: root.file-format; }
                    MetadataRow { label: "分类"; value: root.category; }
                    HorizontalLayout {
                        height: 32px; spacing: 12px;
                        Text { text: "上传者"; width: 52px; color: StudioTheme.muted; vertical-alignment: center; }
                        Button { text: root.uploader; enabled: root.uploader-available; horizontal-stretch: 1; clicked => { root.open-uploader(); } }
                    }
                    MetadataRow { label: "浏览"; value: root.views; }
                    MetadataRow { label: "收藏"; value: root.favorites; }
                    MetadataRow { label: "上传时间"; value: root.created-at; }
                    HorizontalLayout {
                        spacing: 5px;
                        for swatch in root.palette : Rectangle { width: 26px; height: 24px; border-radius: 3px; background: swatch.tint; TouchArea { clicked => { root.search-color(swatch.value); } } }
                    }
                    Button { text: root.downloading ? "下载中…" : "下载原图"; primary: true; enabled: !root.downloading; clicked => { root.download(); } }
                    Button { text: "站内收藏…"; clicked => { root.favorite(); } }
                    Button { text: root.wallpaper-busy ? "正在设置…" : "设为桌面壁纸"; enabled: !root.wallpaper-busy; clicked => { root.set-wallpaper(); } }
                    HorizontalLayout {
                        Button { text: "复制链接"; clicked => { root.copy-link(); } }
                        Button { text: "浏览器打开"; clicked => { root.browser-open(); } }
                    }
                    Button { text: "打开下载目录"; clicked => { root.open-folder(); } }
                    Text { text: root.action-message; color: StudioTheme.accent; wrap: word-wrap; font-size: 12px; }
                    Text { text: root.metadata-busy ? "正在读取详细信息…" : "标签 · 在主窗口搜索"; color: StudioTheme.muted; font-size: 12px; }
                    for tag in root.tags : Button { text: tag.name; clicked => { root.search-tag(tag.query); } }
                }
            }
        }
    }
}
